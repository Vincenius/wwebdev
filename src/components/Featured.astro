---
// Ported from legacy-next/components/Featured. Items are picked by their link
// (render order follows the registry, newest first — as before).
import { allItems } from '../lib/content'

interface Props {
    links: string[]
}

const { links } = Astro.props
const articles = allItems.filter((a) => links.includes(a.link))
---

<div class="ft-container">
    {
        articles.map((a, i) => (
            <div class:list={['ft-article', { margin: i === 1 }]}>
                <a href={a.link}>
                    <img class="ft-preview" src={a.previewImage} alt={a.headline} loading="lazy" />
                </a>
                <a href={a.link}>
                    <h3>{a.headline}</h3>
                </a>
            </div>
        ))
    }
</div>

<style>
    .ft-container {
        display: flex;
        margin-bottom: 62px;
        font-size: 1rem;
    }
    @media (max-width: 480px) {
        .ft-container {
            flex-direction: column;
        }
    }
    .ft-article {
        width: 100%;
        margin: 0;
    }
    .ft-article.margin {
        margin: 0 30px;
    }
    @media (max-width: 480px) {
        .ft-article,
        .ft-article.margin {
            margin: 0 0 30px;
        }
    }
    .ft-article a {
        text-decoration: none;
    }
    .ft-article > * {
        cursor: pointer;
    }
    .ft-article h3 {
        margin: 0;
        font-weight: normal;
        color: var(--color-dark-grey);
        font-size: 1.1em;
    }
    .ft-article h3:hover {
        color: var(--color-accent);
    }
    .ft-preview {
        width: 100%;
        height: 100px;
        object-fit: cover;
    }
    @media (max-width: 480px) {
        .ft-preview {
            height: 160px;
        }
    }
</style>
