---
// Ported from legacy-next/components/Comments (utterances). Renders an empty
// container server-side; the widget script is injected client-side once the
// container scrolls near the viewport (saves the iframe + JS on every article
// view that never reaches the comments).
---

<div id="comments-container"></div>

<script>
    const container = document.getElementById('comments-container')
    const inject = () => {
        const s = document.createElement('script')
        s.async = true
        s.crossOrigin = 'anonymous'
        s.src = 'https://utteranc.es/client.js'
        s.setAttribute('issue-term', 'og:title')
        s.setAttribute('label', 'comment')
        s.setAttribute('repo', 'vincenius/wwebdev-comments')
        s.setAttribute('theme', 'github-light')
        container?.appendChild(s)
    }
    if (container) {
        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    if (entries.some((e) => e.isIntersecting)) {
                        observer.disconnect()
                        inject()
                    }
                },
                { rootMargin: '600px' },
            )
            observer.observe(container)
        } else {
            inject()
        }
    }
</script>
