---
// Ported from legacy-next/components/PrevNext. Neighbors come from the posts
// array order (newest first) — stays correct when entries are added or removed.
import posts from '../data/posts'
import Icon from './Icon.astro'

interface Props {
    link: string
}

const { link } = Astro.props
const index = posts.findIndex((m) => m.link === link)
const prevMeta = index >= 0 ? posts[index + 1] : undefined
const nextMeta = index > 0 ? posts[index - 1] : undefined
---

<div class="pn-container ui-max">
    {
        !prevMeta ? (
            <span />
        ) : (
            <a href={prevMeta.link} class="pn-link">
                <div class="pn-prev">
                    <Icon name="arrow" size={32} />
                    Previous Article
                </div>
                <span>{prevMeta.headline}</span>
            </a>
        )
    }
    {
        nextMeta && (
            <a href={nextMeta.link} class="pn-link pn-right">
                <div class="pn-next">
                    Next Article
                    <Icon name="arrow" size={32} />
                </div>
                <span>{nextMeta.headline}</span>
            </a>
        )
    }
</div>

<style>
    /* width/gutters come from the global .ui-max */
    .pn-container {
        margin-top: 50px;
        margin-bottom: 50px;
        display: flex;
        justify-content: space-between;
    }
    .pn-link {
        max-width: 50%;
        margin: 0 20px 0 0;
        text-align: left;
        cursor: pointer;
    }
    .pn-link.pn-right {
        margin: 0 0 0 20px;
        text-align: right;
    }
    .pn-link span {
        display: block;
    }
    .pn-next,
    .pn-prev {
        display: inline-flex;
        align-items: center;
        margin-bottom: 10px;
    }
    .pn-next :global(svg) {
        margin-left: 10px;
    }
    .pn-prev :global(svg) {
        transform: rotate(180deg);
        margin-right: 10px;
    }
</style>
