---
// Self-promo sponsor banner (replaced the old StatusScout affiliate card).
// Rendered statically in every former ad slot (sidebars + tool pages) and
// links to /sponsorship, which showcases site stats + contact.
---

<a href="/sponsorship" class="sponsor-banner">
    <span class="sponsor-kicker">Your product here?</span>
    <span class="sponsor-title">Sponsor wweb.dev</span>
    <span class="sponsor-text">
        Put your product in front of thousands of web developers every month.
    </span>
    <span class="sponsor-cta">View stats &amp; get in touch &rarr;</span>
</a>

<style>
    .sponsor-banner {
        display: block;
        max-width: 330px;
        margin: 0 auto 1em;
        padding: 16px 18px;
        background: #fff;
        border: 1px solid var(--color-light-grey);
        border-radius: var(--radius);
        box-shadow: var(--shadow-card);
        text-decoration: none;
        line-height: 1.45;
        transition: border-color 0.12s ease;
    }
    .sponsor-banner:hover {
        border-color: var(--color-accent);
    }

    .sponsor-kicker {
        display: block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--color-grey-blue);
        margin-bottom: 4px;
    }

    .sponsor-title {
        display: block;
        font-size: 17px;
        font-weight: 700;
        color: var(--color-heading);
        margin-bottom: 4px;
    }

    .sponsor-text {
        display: block;
        font-size: 14px;
        color: var(--color-body);
        margin-bottom: 8px;
    }

    .sponsor-cta {
        display: block;
        font-size: 14px;
        font-weight: 700;
        color: var(--color-accent);
    }
    .sponsor-banner:hover .sponsor-cta {
        color: var(--color-accent-hover);
    }
</style>
