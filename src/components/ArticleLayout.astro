---
// Ported from legacy-next/components/ArticleLayout. The page's metadata is
// looked up by its own URL (src/data is the registry) — no id prop to keep in
// sync; a missing entry fails the build inside findByLink.
import SidebarLayout from '../layouts/SidebarLayout.astro'
import Comments from './Comments.astro'
import PrevNext from './PrevNext.astro'
import { findByLink } from '../lib/content'

const postMeta = findByLink(Astro.url.pathname)
---

<SidebarLayout
    isArticle={true}
    title={postMeta.headline}
    date={postMeta.date}
    updatedAt={postMeta.updatedAt}
    link={`https://wweb.dev${postMeta.link}`}
    description={postMeta.description}
    image={postMeta.shareImage}
>
    <article class="ui-article-container">
        <slot />

        <Comments />

        <PrevNext link={postMeta.link} />
    </article>
</SidebarLayout>
