---
// Ported from legacy-next/components/SocialBar. Static (no JS).
// Extra <li> (e.g. Search / Mail) are passed via the default slot.
import Icon from './Icon.astro'
---

<ul class="social-bar">
    <li>
        <a href="https://bsky.app/profile/vincentwill.com" target="_blank" rel="noopener">
            <span class="sr-only">Bluesky</span>
            <Icon name="bluesky" />
        </a>
    </li>
    <li>
        <a href="https://github.com/Vincenius/wwebdev" target="_blank" rel="noopener">
            <span class="sr-only">Github</span>
            <Icon name="github" />
        </a>
    </li>
    <li>
        <a href="https://wweb.dev/rss/feed.xml">
            <span class="sr-only">RSS Feed</span>
            <Icon name="rss" />
        </a>
    </li>
    <slot />
</ul>

<style>
    .social-bar {
        list-style: none;
        display: inline-flex;
        align-items: center;
        margin: 0;
        padding: 0;
    }

    /* :global so the fill also reaches slotted icons (search / mail) */
    .social-bar :global(svg) {
        fill: var(--color-light-grey);
    }

    .social-bar :global(svg:hover) {
        fill: #fff;
    }

    .social-bar :global(li a) {
        padding: 16px 20px;
    }

    .social-bar :global(li:last-child a) {
        padding-right: 0;
    }

    .social-bar :global(li:first-child a) {
        padding-left: 0;
    }
</style>
