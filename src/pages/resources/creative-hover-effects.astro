---
// Demo showcase in the sidebar tool layout (like loader-generator): headline +
// intro, demo cards in the main column, Ad in the sidebar, Featured below.
// Each effect renders in a dark preview pane inside a LinkBox-style card.
// The only interactivity is a click-to-toggle 'hover' class (touch devices),
// done with a tiny inline script — no React island needed.
import Layout from '../../layouts/Layout.astro'
import Ad from '../../components/Ad.astro'
import Featured from '../../components/Featured.astro'
import { findByLink } from '../../lib/content'

const postMeta = findByLink(Astro.url.pathname)

const demos = [
    { key: 'wave', label: 'Wave', pen: 'https://codepen.io/Vincenius/pen/OJyxeaN' },
    { key: 'stripes', label: 'Stripes', pen: 'https://codepen.io/Vincenius/pen/NWGaZod' },
    { key: 'curvy', label: 'Curvy', pen: 'https://codepen.io/Vincenius/pen/VwvMJNo' },
    { key: 'border', label: 'Border', pen: 'https://codepen.io/Vincenius/pen/bGVoPPq' },
    { key: 'gradient', label: 'Gradient', pen: 'https://codepen.io/Vincenius/pen/vYNeoKL' },
    { key: 'stripes2', label: 'Stripes 2', pen: 'https://codepen.io/Vincenius/pen/vYNeoyL' },
]
---

<Layout
    isArticle={true}
    hideHeader={true}
    title={postMeta.headline}
    date={postMeta.date}
    link={`https://wweb.dev${postMeta.link}`}
    description={postMeta.description}
    image={postMeta.shareImage}
>
    <div class="ui-container">
        <h1 class="ui-section-headline">Creative Hover Effects</h1>
        <div class="ui-sidebar-container">
            <article class="ui-sidebar-article">
                <p>
                    A collection of six creative hover effects for your inspiration. Each effect
                    links to a Codepen for easy copy-pasting — the full collection is also available
                    on{' '}<a
                        href="https://github.com/wwebdev/hover-effect-ideas"
                        target="_blank"
                        rel="noopener noreferrer">GitHub</a
                    >.<span class="che-tap-hint"> Tap an effect to play its animation.</span>
                </p>

                <div class="ui-grid no-padding">
                    {
                        demos.map((d) => (
                            <section class="che-card">
                                <div class="che-pane">
                                    <a href="#" class={`che-effect che-${d.key}`}>
                                        HOVER ME
                                    </a>
                                </div>
                                <div class="che-card-footer">
                                    <h2>{d.label}</h2>
                                    <a href={d.pen} target="_blank" rel="noopener noreferrer">
                                        Codepen
                                    </a>
                                </div>
                            </section>
                        ))
                    }
                </div>

                <h2 class="ui-subheadline">You might also like</h2>
                <Featured
                    links={[
                        '/resources/creative-backgrounds',
                        '/resources/css-separator-generator',
                        '/resources/animated-css-background-generator',
                    ]}
                />
            </article>
            <aside class="ui-sidebar">
                <Ad />
            </aside>
        </div>
    </div>
</Layout>

<script>
    document.querySelectorAll<HTMLAnchorElement>('.che-effect').forEach((el) => {
        el.addEventListener('click', (e) => {
            e.preventDefault()
            el.classList.toggle('hover')
        })
    })
</script>

<style>
    /* The demo grid's intrinsic width would otherwise keep this flex column
       from shrinking and push the sidebar out of the container. */
    article.ui-sidebar-article {
        min-width: 0;
    }

    /* Hint only matters where hovering isn't possible. */
    .che-tap-hint {
        display: none;
    }
    @media (hover: none) {
        .che-tap-hint {
            display: inline;
        }
    }

    /* LinkBox-style card: dark preview pane on top, white footer below. */
    .che-card {
        background: #fff;
        border-radius: var(--radius);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .che-pane {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 200px;
        padding: 40px 32px;
        background: var(--color-dark-grey);
    }
    .che-card-footer {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        padding: 16px 20px;
    }
    .che-card-footer h2 {
        margin: 0;
        font-size: 1.1em;
        font-weight: 500;
    }

    .che-effect {
        color: #fff;
        font-weight: bold;
        text-decoration: none;
        font-size: 2rem;
        white-space: nowrap;
    }
    @media (max-width: 480px) {
        .che-effect {
            font-size: 1.6rem;
        }
    }

    .che-wave {
        color: transparent;
        background: url('/resources/creative-hover-effects/wave.svg') repeat-x #fff;
        background-clip: text;
        background-size: 200% 100%;
        background-position-x: 0;
        background-position-y: 1em;
        transition: background-position-y 0.6s ease;
        animation: waveAnimation 4s infinite linear;
        animation-play-state: paused;
    }
    .che-wave:hover,
    .che-wave.hover {
        background-position-x: 0;
        background-position-y: 0;
        animation-play-state: running;
    }
    @keyframes waveAnimation {
        from {
            background-position-x: 0%;
        }
        to {
            background-position-x: 200%;
        }
    }

    .che-stripes {
        color: transparent;
        background: url('/resources/creative-hover-effects/stripes.png') repeat #fff;
        background-size: 100%;
        background-position: 0%;
        background-clip: text;
        animation: stripeAnimation 3s linear infinite;
        animation-play-state: paused;
    }
    .che-stripes:hover,
    .che-stripes.hover {
        animation-play-state: running;
    }
    @keyframes stripeAnimation {
        100% {
            background-position-y: -200%;
        }
    }

    .che-curvy {
        background:
            radial-gradient(
                circle at 100% 50%,
                transparent 20%,
                rgba(0, 0, 0, 0.5) 21%,
                rgba(0, 0, 0, 0.5) 34%,
                transparent 35%,
                transparent
            ),
            radial-gradient(
                    circle at 0% 50%,
                    transparent 20%,
                    rgba(0, 0, 0, 0.5) 21%,
                    rgba(0, 0, 0, 0.5) 34%,
                    transparent 35%,
                    transparent
                )
                0 -50px;
        background-color: #fff;
        background-size: 75px 100px;
        background-clip: text;
        background-repeat: repeat-x;
        background-position-y: -2em;
        transition: background-position-y 0.6s ease;
        color: transparent;
        animation: curvyAnimation 3s linear infinite;
        animation-play-state: paused;
    }
    .che-curvy:hover,
    .che-curvy.hover {
        animation-play-state: running;
        background-position-y:
            0%,
            -50px;
    }
    @keyframes curvyAnimation {
        100% {
            background-position-x: 135%;
        }
    }

    .che-border {
        position: relative;
        text-shadow:
            -2px 0 var(--color-green-blue),
            0 2px var(--color-green-blue),
            2px 0 var(--color-green-blue),
            0 -2px var(--color-green-blue);
        width: 100%;
        transition: width 0.5s ease;
    }
    .che-border::after {
        content: 'HOVER ME';
        color: #fff;
        position: absolute;
        top: 0;
        left: 0;
        text-shadow:
            -2px 0 #000,
            0 2px #000,
            2px 0 #000,
            0 -2px #000;
        width: 100%;
        white-space: nowrap;
        overflow: hidden;
    }
    .che-border:hover,
    .che-border.hover {
        width: 0%;
    }

    .che-gradient {
        background: rgba(0, 0, 0, 0)
            linear-gradient(
                90deg,
                hsl(141, 81%, 76%),
                hsl(186, 81%, 76%),
                hsl(231, 81%, 76%),
                hsl(276, 81%, 76%),
                hsl(321, 81%, 76%),
                hsl(6, 81%, 76%),
                hsl(51, 81%, 76%),
                hsl(96, 81%, 76%)
            )
            repeat scroll 0% 0% / 200% 200%;
        color: transparent;
        background-clip: text;
    }
    .che-gradient:hover,
    .che-gradient.hover {
        animation: GradientAnimation 2s ease infinite;
    }
    @keyframes GradientAnimation {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }

    .che-stripes2 {
        position: relative;
        color: transparent;
        background-image: repeating-linear-gradient(
            45deg,
            rgb(241, 241, 241) 0px,
            rgb(241, 241, 241) 144px,
            rgb(128, 128, 128) 144px,
            rgb(128, 128, 128) 288px,
            rgb(190, 190, 190) 288px,
            rgb(190, 190, 190) 432px
        );
        background-size: 250%;
        background-position: 0%;
        background-clip: text;
        animation: stripe2Animation 3s linear infinite;
        animation-play-state: paused;
    }
    .che-stripes2:hover,
    .che-stripes2.hover {
        animation-play-state: running;
    }
    @keyframes stripe2Animation {
        100% {
            background-position: 165%;
        }
    }
</style>
