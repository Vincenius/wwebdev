---
// Ported from legacy-next/pages/resources/creative-hover-effects.js +
// components/CreativeHoverEffects. Full-screen dark demo page (no Layout/Footer).
// The only interactivity is a click-to-toggle 'hover' class (touch devices), done
// with a tiny inline script — no React island needed.
import '@fontsource/lato/300.css'
import '@fontsource/lato/400.css'
import '@fontsource/lato/700.css'
import '@fontsource/lato/900.css'
import '../../styles/global.css'
import Head from '../../layouts/Head.astro'
import Nav from '../../components/Nav.astro'
import posts from '../../data/posts'

const postMeta = posts.find((m) => m.id === 13)!

const demos = [
    { key: 'wave', label: 'Wave', pen: 'https://codepen.io/Vincenius/pen/OJyxeaN' },
    { key: 'stripes', label: 'Stripes', pen: 'https://codepen.io/Vincenius/pen/NWGaZod' },
    { key: 'curvy', label: 'Curvy', pen: 'https://codepen.io/Vincenius/pen/VwvMJNo' },
    { key: 'border', label: 'Border', pen: 'https://codepen.io/Vincenius/pen/bGVoPPq' },
    { key: 'gradient', label: 'Gradient', pen: 'https://codepen.io/Vincenius/pen/vYNeoKL' },
    { key: 'stripes2', label: 'Stripes 2', pen: 'https://codepen.io/Vincenius/pen/vYNeoyL' },
]
// Laid out two-per-row, matching the original DemoContainer grouping.
const rows = [demos.slice(0, 2), demos.slice(2, 4), demos.slice(4, 6)]
---

<!doctype html>
<html lang="en" dir="ltr">
    <head>
        <Head
            isArticle={true}
            title={postMeta.headline}
            link={`https://wweb.dev${postMeta.link}`}
            description={postMeta.description}
            image={postMeta.shareImage}
            date={new Date(postMeta.date)}
        />
    </head>
    <body>
        <div class="che-container">
            <Nav isArticle={true} />

            <div class="che-wrapper">
                <h1>
                    Creative Hover Effects
                    <a
                        class="che-github"
                        href="https://github.com/wwebdev/hover-effect-ideas"
                        target="_blank"
                        rel="noopener"
                    >
                        [<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 16 16"
                            ><path
                                fill-rule="evenodd"
                                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
                            ></path></svg
                        >]
                    </a>
                </h1>
                <p class="che-subline">Tap to see the hover effect</p>

                {rows.map((row) => (
                    <section class="che-demo-container">
                        {row.map((d) => (
                            <div class="che-demo">
                                <h2>
                                    {d.label}
                                    <a href={d.pen} target="_blank" rel="noopener noreferrer">[Codepen]</a>
                                </h2>
                                <a href="#" class={`che-effect che-${d.key}`} data-hover={d.key}>HOVER ME</a>
                            </div>
                        ))}
                    </section>
                ))}
            </div>
        </div>

        <script>
            document.querySelectorAll<HTMLAnchorElement>('.che-effect').forEach((el) => {
                el.addEventListener('click', (e) => {
                    e.preventDefault()
                    el.classList.toggle('hover')
                })
            })
        </script>

        <style>
            .che-container {
                position: relative;
                min-height: 100vh;
                height: 100%;
                font-size: 1.6rem;
                background-color: #001224;
                color: #fff;
                width: 100%;
            }
            .che-wrapper {
                display: flex;
                flex-direction: column;
                align-items: space-between;
                justify-content: center;
                max-width: 1128px;
                margin: 0 auto;
                padding: 44px;
            }
            .che-wrapper h1,
            .che-wrapper h2 {
                margin-bottom: 0.8em;
                max-width: 100%;
                line-height: 1.1em;
            }
            .che-wrapper h1 {
                margin-top: 0;
                margin-bottom: 1.1em;
                text-decoration: underline;
                color: #fff;
            }
            @media (max-width: 800px) {
                .che-wrapper h1 {
                    font-size: 1.5em;
                    margin-bottom: 0;
                }
            }
            @media (max-width: 768px) {
                .che-wrapper h1 {
                    text-align: center;
                }
            }
            @media (max-width: 600px) {
                .che-wrapper h1 {
                    font-size: 1.2em;
                }
            }
            .che-wrapper h2,
            .che-wrapper h2 a {
                font-weight: 300;
                font-size: 18px;
            }
            .che-wrapper h2 {
                display: inline-flex;
                justify-content: space-between;
                color: #fff;
            }
            .che-wrapper h2 a {
                color: #4fc3f7;
                text-decoration: none;
            }
            .che-wrapper h2 a:hover {
                color: #03a9f4;
                text-decoration: underline;
            }
            .che-effect {
                color: #fff;
                font-weight: bold;
                text-decoration: none;
                font-size: 2em;
            }
            @media (max-width: 600px) {
                .che-effect {
                    font-size: 1.6em;
                }
            }

            .che-subline {
                display: none;
                font-size: 0.6em;
            }
            @media (max-width: 800px) {
                .che-subline {
                    display: block;
                    margin-bottom: 3em;
                    text-align: center;
                }
            }

            .che-github {
                font-size: 1em !important;
                color: #4fc3f7 !important;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                margin-left: 0.2em;
            }
            .che-github:hover {
                color: #03a9f4 !important;
            }
            .che-github:hover svg {
                fill: #03a9f4;
            }
            .che-github svg {
                fill: #4fc3f7;
                width: 1em;
                height: 0.8em;
            }

            .che-demo-container {
                display: flex;
                justify-content: space-between;
                margin-bottom: 50px;
            }
            .che-demo-container > * {
                margin-right: 50px;
            }
            .che-demo-container > *:last-child {
                margin-right: 0;
            }
            @media (max-width: 768px) {
                .che-demo-container {
                    flex-direction: column;
                    align-items: center;
                    margin-bottom: 0;
                }
                .che-demo-container > * {
                    margin-right: 0;
                }
            }
            .che-demo {
                display: flex;
                flex-direction: column;
            }
            @media (max-width: 768px) {
                .che-demo {
                    margin-bottom: 50px;
                    max-width: 300px;
                }
            }

            .che-wave {
                color: transparent !important;
                background: url('/resources/creative-hover-effects/wave.svg') repeat-x #fff;
                background-clip: text;
                background-size: 200% 100%;
                background-position-x: 0;
                background-position-y: 1em;
                transition: background-position-y 0.6s ease;
                animation: waveAnimation 4s infinite linear;
                animation-play-state: paused;
            }
            .che-wave:hover,
            .che-wave.hover {
                background-position-x: 0;
                background-position-y: 0;
                animation-play-state: running;
            }
            @keyframes waveAnimation {
                from {
                    background-position-x: 0%;
                }
                to {
                    background-position-x: 200%;
                }
            }

            .che-stripes {
                color: transparent !important;
                background: url('/resources/creative-hover-effects/stripes.png') repeat #fff;
                background-size: 100%;
                background-position: 0%;
                background-clip: text;
                animation: stripeAnimation 3s linear infinite;
                animation-play-state: paused;
            }
            .che-stripes:hover,
            .che-stripes.hover {
                animation-play-state: running;
            }
            @keyframes stripeAnimation {
                100% {
                    background-position-y: -200%;
                }
            }

            .che-curvy {
                background: radial-gradient(circle at 100% 50%, transparent 20%, rgba(0, 0, 0, 0.5) 21%, rgba(0, 0, 0, 0.5) 34%, transparent 35%, transparent),
                    radial-gradient(circle at 0% 50%, transparent 20%, rgba(0, 0, 0, 0.5) 21%, rgba(0, 0, 0, 0.5) 34%, transparent 35%, transparent) 0 -50px;
                background-color: #fff;
                background-size: 75px 100px;
                background-clip: text;
                background-repeat: repeat-x;
                background-position-y: -2em;
                transition: background-position-y 0.6s ease;
                color: transparent !important;
                animation: curvyAnimation 3s linear infinite;
                animation-play-state: paused;
            }
            .che-curvy:hover,
            .che-curvy.hover {
                animation-play-state: running;
                background-position-y: 0%, -50px;
            }
            @keyframes curvyAnimation {
                100% {
                    background-position-x: 135%;
                }
            }

            .che-border {
                position: relative;
                white-space: nowrap;
                text-shadow: -2px 0 #00c6a7, 0 2px #00c6a7, 2px 0 #00c6a7, 0 -2px #00c6a7;
                width: 100%;
                transition: width 0.5s ease;
            }
            .che-border::after {
                content: 'HOVER ME';
                color: #fff;
                position: absolute;
                top: 0;
                left: 0;
                text-shadow: -2px 0 #000, 0 2px #000, 2px 0 #000, 0 -2px #000;
                width: 100%;
                white-space: nowrap;
                overflow: hidden;
            }
            .che-border:hover,
            .che-border.hover {
                width: 0%;
            }

            .che-gradient {
                background: rgba(0, 0, 0, 0) linear-gradient(90deg, hsl(141, 81%, 76%), hsl(186, 81%, 76%), hsl(231, 81%, 76%), hsl(276, 81%, 76%), hsl(321, 81%, 76%), hsl(6, 81%, 76%), hsl(51, 81%, 76%), hsl(96, 81%, 76%)) repeat scroll 0% 0% / 200% 200%;
                color: transparent !important;
                background-clip: text;
            }
            .che-gradient:hover,
            .che-gradient.hover {
                animation: GradientAnimation 2s ease infinite;
            }
            @keyframes GradientAnimation {
                0% {
                    background-position: 0% 50%;
                }
                50% {
                    background-position: 100% 50%;
                }
                100% {
                    background-position: 0% 50%;
                }
            }

            .che-stripes2 {
                position: relative;
                color: transparent !important;
                background-image: repeating-linear-gradient(45deg, rgb(241, 241, 241) 0px, rgb(241, 241, 241) 144px, rgb(128, 128, 128) 144px, rgb(128, 128, 128) 288px, rgb(190, 190, 190) 288px, rgb(190, 190, 190) 432px);
                background-size: 250%;
                background-position: 0%;
                background-clip: text;
                animation: stripe2Animation 3s linear infinite;
                animation-play-state: paused;
            }
            .che-stripes2:hover,
            .che-stripes2.hover {
                animation-play-state: running;
            }
            @keyframes stripe2Animation {
                100% {
                    background-position: 165%;
                }
            }
        </style>
    </body>
</html>
