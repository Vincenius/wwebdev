<style>
    .sp-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 20px;
        margin: 30px 0 10px;
    }

    .sp-stat {
        background: #fff;
        border: 1px solid var(--color-light-grey);
        border-radius: var(--radius);
        box-shadow: var(--shadow-card);
        padding: 20px 16px;
        text-align: center;
    }

    .sp-stat-value {
        display: block;
        font-size: 1.8em;
        font-weight: 700;
        line-height: 1.2;
        color: var(--color-accent);
    }

    .sp-stat-label {
        display: block;
        font-size: 0.75em;
        color: var(--color-grey-blue);
        margin-top: 4px;
    }

    .sp-stats-note {
        font-size: 0.75em;
        color: var(--color-grey-blue);
        margin-top: 0;
    }

    .sp-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }
    @media (max-width: 640px) {
        .sp-columns {
            grid-template-columns: 1fr;
            gap: 0;
        }
    }

    .sp-columns h3 {
        font-size: 1.1em;
        font-weight: 400;
        margin: 0 0 10px;
    }

    .sp-list {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 0.9em;
    }
    /* .sp-columns prefix outranks ui.css's `.ui-article-container ul li` margin */
    .sp-columns .sp-list li {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 8px 0;
        border-bottom: 1px solid var(--color-light-grey);
        margin: 0;
    }
    .sp-list b {
        color: var(--color-heading);
    }

    .sp-contact-button {
        display: inline-block;
        background: var(--color-accent);
        color: #fff;
        font-weight: 700;
        text-decoration: none;
        padding: 12px 28px;
        border-radius: var(--radius);
    }
    .sp-contact-button:hover {
        background: var(--color-accent-hover);
        color: #fff;
    }
</style>
