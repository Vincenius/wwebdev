---
// Ported from legacy-next/components/Layout (+ _document/_app shell).
import '@fontsource/lato/300.css'
import '@fontsource/lato/400.css'
import '@fontsource/lato/700.css'
import '../styles/global.css'
import '../styles/ui.css'
import '../styles/linkbox.css'
import '../styles/forms.css'

import Head from './Head.astro'
import Nav from '../components/Nav.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { formatDisplayDate } from '../lib/dates'
import type { LayoutProps } from './layoutProps'

type Props = LayoutProps

const {
    title,
    isArticle = false,
    hideHeader = false,
    date,
    link,
    image,
    description,
    titleNameFirst,
    updatedAt,
    noindex,
} = Astro.props

const d = date ? new Date(date) : undefined
const ud = updatedAt ? new Date(updatedAt) : undefined
---

<!doctype html>
<html lang="en" dir="ltr">
    <head>
        <Head
            title={title}
            link={link}
            image={image}
            description={description}
            date={d}
            updatedDate={ud}
            isArticle={isArticle}
            titleNameFirst={titleNameFirst}
            noindex={noindex}
        />
    </head>
    <body>
        <div class="layout-container">
            <Nav title={title} isArticle={isArticle} />

            {
                isArticle && !hideHeader && (
                    <Header>
                        <h1>{title}</h1>
                        {d && date && (
                            <p class="s-date">
                                <time class="s-time" datetime={d.toISOString()}>
                                    {formatDisplayDate(date)}
                                </time>
                            </p>
                        )}
                        {updatedAt && ud && (
                            <p class="s-date s-updated">
                                Updated:{' '}
                                <time class="s-time" datetime={ud.toISOString()}>
                                    {formatDisplayDate(updatedAt)}
                                </time>
                            </p>
                        )}
                    </Header>
                )
            }

            <main>
                <slot />
            </main>

            <Footer />
        </div>
    </body>
</html>

<style>
    .layout-container {
        margin: 0 auto;
        background: #fff;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        justify-content: space-between;
    }

    .s-time {
        font-size: 1rem;
        line-height: 30px;
        margin-right: 3px;
    }
    .s-date {
        margin-bottom: 0;
        color: var(--color-grey-blue);
    }
    .s-updated {
        margin: 0 auto;
        font-style: italic;
    }
</style>
